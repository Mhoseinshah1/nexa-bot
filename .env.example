# ---------------------------------------------------------------------------
# Nexa Bot — environment configuration
#
# Every variable below is validated at boot by packages/.../config. The process
# refuses to start if any required value is missing or malformed, and it reports
# every problem at once rather than the first one.
#
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Runtime -------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# HTTP ----------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3000

# PostgreSQL ----------------------------------------------------------------
DATABASE_URL=postgres://nexa:nexa@127.0.0.1:5432/nexa_dev
DATABASE_POOL_MAX=10

# Redis ---------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# Secrets -------------------------------------------------------------------
# Key-encryption key for envelope encryption of stored credentials (bot tokens,
# and later panel/gateway credentials). 32 bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_KEK=REPLACE_ME_WITH_32_RANDOM_BYTES_BASE64
# Identifier for the active KEK, recorded on every ciphertext so keys can rotate.
SECRETS_KEK_ID=dev-1

# Authentication ------------------------------------------------------------
# `password` is the real Web Admin surface: username and password against the
# admins table. See docs/adr/0013-web-admin-authentication.md.
# `none` remains a development-only escape hatch and is refused unless
# NODE_ENV=development.
AUTH_MODE=password

# How long a session lives without being renewed. Sessions carry identity, not
# authority — permissions are resolved per request — so this is not a bound on
# how long a revoked administrator keeps their powers.
SESSION_TTL_SECONDS=43200

# Password hashing cost. `production` is scrypt at the OWASP minimum
# (N=2^17, r=8, p=1). `fast` exists for the test suite and is REFUSED when
# NODE_ENV=production: it lowers the work factor by more than two orders of
# magnitude.
PASSWORD_HASH_PROFILE=production

# Brute-force protection. A lockout refuses the correct password too — one that
# let it through would only ever throttle an attacker's last guess.
LOGIN_MAX_ATTEMPTS_PER_USERNAME=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_THROTTLE_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900

# Bounds on a database connection's waiting and working. Postgres defaults all
# three to 0 — wait forever — which turns one stalled transaction holding the
# tenant row into an installation-wide outage with no error to see. Migrations
# are exempt and open their own connection without these.
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000

# How long an EXPIRED admin session row is kept before worker housekeeping
# removes it. Not the session's lifetime (SESSION_TTL_SECONDS is that) — this
# is how long the dead row stays readable afterwards, since it carries the IP
# and user agent a sign-in came from and the audit log points at it by id.
SESSION_RETENTION_SECONDS=2592000

# Origins the browser admin may call from, comma-separated. REQUIRED in
# production: the Origin check is the half of the CSRF defence that does not
# depend on the browser honouring SameSite.
WEB_ADMIN_ORIGINS=

# How this installation is exposed. The two topologies need opposite settings,
# so it is stated rather than guessed:
#
#   reverse-proxy  the standard deployment, Caddy in front. REQUIRES a non-empty
#                  TRUSTED_PROXY_IPS naming the addresses Caddy connects from.
#   direct         nothing in front of this process. REQUIRES TRUSTED_PROXY_IPS
#                  to be empty, so X-Forwarded-For is ignored entirely and the
#                  client IP is the socket address, which nobody can forge.
#
# An empty list is correct for one topology and a serious misconfiguration for
# the other, and nothing at runtime can tell them apart — behind a proxy with
# nothing trusted, every request appears to come from Caddy and one failed-login
# burst locks out every administrator.
DEPLOYMENT_TOPOLOGY=reverse-proxy

# Which upstreams may be believed about the client's IP: a comma-separated list
# of IPs or CIDRs. Every entry is validated at boot; a typo fails the boot
# rather than silently voiding or widening the trusted set.
#
# There is deliberately no "trust everything" setting, and a /0 prefix is
# refused for the same reason: it would believe the header from whoever
# connects, so anyone reaching the port directly could choose their own IP —
# defeating per-IP login throttling and writing an address of their choosing
# into the audit log.
#
# Behind Caddy on the same host:
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Telegram ------------------------------------------------------------------
# The webhook receiver is disabled by default. The route names the bot instance
# — /telegram/webhook/<bot_instance_id> — because Telegram's update_id is a
# per-bot sequence, so idempotency keyed on it alone makes one bot's update look
# like a replay of another's. When enabled, every update must carry a matching
# X-Telegram-Bot-Api-Secret-Token header of at least 16 characters.
TELEGRAM_WEBHOOK_ENABLED=false
TELEGRAM_WEBHOOK_SECRET=

# Outbox relay --------------------------------------------------------------
OUTBOX_RELAY_ENABLED=true
OUTBOX_RELAY_BATCH_SIZE=100
OUTBOX_RELAY_POLL_INTERVAL_MS=1000
# Alert threshold: the relay is unhealthy if the oldest unpublished message is
# older than this (12 §10 of the architecture review: alert if lag > 5 min).
OUTBOX_RELAY_MAX_LAG_MS=300000

# How long a graceful shutdown may take before the process exits anyway.
# Keep it below the orchestrator's grace period, so a stuck close is reported
# rather than killed mid-sentence.
SHUTDOWN_TIMEOUT_MS=15000

# Provider panels: the outbound HTTP client ---------------------------------
# The whole call — DNS, connect, TLS, request and the response body. A
# per-socket timeout does not bound a panel that sends a byte every few
# seconds forever.
PANEL_HTTP_TIMEOUT_MS=10000
# Response bytes kept from a panel. Reading stops the moment this is passed.
PANEL_HTTP_MAX_RESPONSE_BYTES=524288
# Whether a panel may live on this process's own loopback interface. Refused
# outright in production: the API runs in a container, so its loopback is the
# API, and a panel URL pointing there reaches this installation's internals
# rather than a panel. The integration suite sets it true to reach a local
# fake server, which is the only legitimate use.
PANEL_HTTP_ALLOW_LOOPBACK=false
# Optional PEM bundle of extra certificate authorities to trust for panel
# calls, for a self-hosted panel behind an organisation's own CA. ADDITIONAL
# to the system trust store, never instead of it — certificate verification
# stays on either way. Leave unset for ordinary public verification.
PANEL_HTTP_CA_FILE=

# This installation's own data network — the bridge PostgreSQL and Redis sit
# on — which a panel may never point at. In production compose passes it from
# NEXA_DATA_SUBNET in deploy.env; set it here only when running outside
# compose against a network that should be refused. Private space otherwise
# stays reachable on purpose.
NEXA_DATA_SUBNET=
# EXTRA networks to refuse, comma-separated CIDRs. Empty by default.
PANEL_HTTP_DENIED_SUBNETS=

# How long one panel's connection test occupies that panel, in milliseconds.
# A probe logs into somebody else's panel: repeated without a bound it is both
# a way to sweep a network one panel edit at a time and a way to lock the
# provider account it authenticates with. Within the window the caller gets the
# stored result of the last probe of the same configuration; changing the panel
# or a credential bypasses it. Raised to PANEL_HTTP_TIMEOUT_MS when that is
# larger, and there is no off switch.
PANEL_PROBE_COOLDOWN_MS=10000

# Background panel health monitoring (the `monitor` process role) ------------
#
# A dedicated process from the same image, `node dist/main.monitor.js`. Not an
# interval inside the API: a probe is an outbound call to somebody else's
# machine with a timeout measured in seconds, and it must not share the event
# loop that answers the Telegram webhook.
#
# Turning it off leaves panel health changing only when an operator presses
# "Test connection". The process still runs and still reports itself healthy —
# a deliberately disabled monitor is not a broken one.
PANEL_MONITOR_ENABLED=true

# How often the loop wakes. NOT the probe cadence: a tick that finds nothing
# due does nothing. It bounds how late a due panel can be.
PANEL_MONITOR_TICK_MS=30000

# How long a HEALTHY result stands before a re-probe. Ten minutes against a
# fifteen-minute freshness window, so the refresh lands before an operator's
# view of the result goes stale. Capped at twelve minutes, because each panel
# also carries a deterministic spread of up to a tenth of its interval.
PANEL_MONITOR_HEALTHY_INTERVAL_MS=600000

# After a RETRYABLE failure — a timeout, an unreachable host, a provider error.
# These are the ones that fix themselves, so trying again soon is the point.
PANEL_MONITOR_RETRYABLE_INTERVAL_MS=120000

# After a failure that trying again CANNOT fix: rejected credentials, a refused
# target, a TLS failure, a response the provider does not produce. Long, and
# doubling to a bound with each consecutive failure, because several panels —
# 3X-UI v3.7.0 among them — lock an account after enough failed logins, and a
# monitor that resubmits a rejected password on a timer would do that to the
# operator on Nexa's behalf. An operator who fixes the credential does not wait
# this out: replacing one makes the panel due immediately.
PANEL_MONITOR_NONRETRYABLE_INTERVAL_MS=3600000

# Panels considered in one tick, and probes in flight at once. The first bounds
# the discovery query; the second bounds outbound sockets and pool checkouts.
PANEL_MONITOR_BATCH_SIZE=50
PANEL_MONITOR_CONCURRENCY=4

# The share of each tenant's probe budget the background loop must leave behind,
# as a percentage. One bucket with two floors: an operator may spend a tenant's
# capacity down to nothing, the monitor is refused below the reserve. Without
# it, a tenant whose panels are all failing and retrying would have no capacity
# left when somebody presses "Test connection".
PANEL_MONITOR_BUDGET_RESERVE_PERCENT=40

# Where the monitor writes the heartbeat its container health check reads. Its
# own file: two roles writing one would let a healthy worker mask a dead
# monitor. Written only when the database is reachable AND a monitoring
# iteration has completed recently.
PANEL_MONITOR_HEARTBEAT_PATH=/tmp/nexa-monitor.heartbeat

# Build metadata (populated by CI; optional locally) -------------------------
BUILD_VERSION=
BUILD_COMMIT=
BUILD_TIME=
