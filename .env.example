# ---------------------------------------------------------------------------
# Nexa Bot — environment configuration
#
# Every variable below is validated at boot by packages/.../config. The process
# refuses to start if any required value is missing or malformed, and it reports
# every problem at once rather than the first one.
#
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Runtime -------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# HTTP ----------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3000

# PostgreSQL ----------------------------------------------------------------
DATABASE_URL=postgres://nexa:nexa@127.0.0.1:5432/nexa_dev
DATABASE_POOL_MAX=10

# Redis ---------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# Secrets -------------------------------------------------------------------
# The keyring: `id:base64,id:base64`, 32 random bytes per key. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# ONE key encrypts (SECRETS_ACTIVE_KEY_ID); ALL of them decrypt. That is what
# makes rotation a period of overlap rather than a flag day, and it is the
# CANONICAL spelling — the one `deploy/nexa.env.template` generates and the one a
# new configuration should use.
SECRETS_KEYS=dev-1:REPLACE_ME_WITH_32_RANDOM_BYTES_BASE64
SECRETS_ACTIVE_KEY_ID=dev-1

# The v1 spelling, still accepted, and listed SECOND on purpose.
#
# It aliases to a one-entry keyring whose only key is the active one, which is
# precisely what v1 did, so an installation that predates the keyring keeps
# booting without being hand-edited. Do not start here: this file used to offer
# only these two, which meant a new configuration adopted the retired envelope —
# and because `SECRETS_ACCEPT_V1` has no default and is derived from which
# spelling is present, it also turned v1 ACCEPTANCE on. A v1 ciphertext carries
# no associated data and so remains transplantable between rows; that is what
# acceptance costs, and a configuration written today should not be paying it.
#
# Set EITHER the pair above or the pair below, never both.
# SECRETS_KEK=REPLACE_ME_WITH_32_RANDOM_BYTES_BASE64
# SECRETS_KEK_ID=dev-1

# Whether v1 ciphertext may still be read. No default: absent means "derive it
# from the spelling above" — on for a legacy SECRETS_KEK configuration, off for a
# canonical SECRETS_KEYS one. `botctl secrets status` prints which is in force.
SECRETS_ACCEPT_V1=false

# Authentication ------------------------------------------------------------
# `password` is the real Web Admin surface: username and password against the
# admins table. See docs/adr/0013-web-admin-authentication.md.
# `none` remains a development-only escape hatch and is refused unless
# NODE_ENV=development.
AUTH_MODE=password

# How long a session lives without being renewed. Sessions carry identity, not
# authority — permissions are resolved per request — so this is not a bound on
# how long a revoked administrator keeps their powers.
SESSION_TTL_SECONDS=43200

# Password hashing cost. `production` is scrypt at the OWASP minimum
# (N=2^17, r=8, p=1). `fast` exists for the test suite and is REFUSED when
# NODE_ENV=production: it lowers the work factor by more than two orders of
# magnitude.
PASSWORD_HASH_PROFILE=production

# Brute-force protection. A lockout refuses the correct password too — one that
# let it through would only ever throttle an attacker's last guess.
LOGIN_MAX_ATTEMPTS_PER_USERNAME=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_THROTTLE_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900

# Bounds on a database connection's waiting and working. Postgres defaults all
# three to 0 — wait forever — which turns one stalled transaction holding the
# tenant row into an installation-wide outage with no error to see. Migrations
# are exempt and open their own connection without these.
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000

# How long an EXPIRED admin session row is kept before worker housekeeping
# removes it. Not the session's lifetime (SESSION_TTL_SECONDS is that) — this
# is how long the dead row stays readable afterwards, since it carries the IP
# and user agent a sign-in came from and the audit log points at it by id.
SESSION_RETENTION_SECONDS=2592000

# Origins the browser admin may call from, comma-separated. REQUIRED in
# production: the Origin check is the half of the CSRF defence that does not
# depend on the browser honouring SameSite.
WEB_ADMIN_ORIGINS=

# How this installation is exposed. The two topologies need opposite settings,
# so it is stated rather than guessed:
#
#   reverse-proxy  the standard deployment, Caddy in front. REQUIRES a non-empty
#                  TRUSTED_PROXY_IPS naming the addresses Caddy connects from.
#   direct         nothing in front of this process. REQUIRES TRUSTED_PROXY_IPS
#                  to be empty, so X-Forwarded-For is ignored entirely and the
#                  client IP is the socket address, which nobody can forge.
#
# An empty list is correct for one topology and a serious misconfiguration for
# the other, and nothing at runtime can tell them apart — behind a proxy with
# nothing trusted, every request appears to come from Caddy and one failed-login
# burst locks out every administrator.
DEPLOYMENT_TOPOLOGY=reverse-proxy

# Which upstreams may be believed about the client's IP: a comma-separated list
# of IPs or CIDRs. Every entry is validated at boot; a typo fails the boot
# rather than silently voiding or widening the trusted set.
#
# There is deliberately no "trust everything" setting, and a /0 prefix is
# refused for the same reason: it would believe the header from whoever
# connects, so anyone reaching the port directly could choose their own IP —
# defeating per-IP login throttling and writing an address of their choosing
# into the audit log.
#
# Behind Caddy on the same host:
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Telegram ------------------------------------------------------------------
# The webhook receiver is disabled by default. The route names the bot instance
# — /telegram/webhook/<bot_instance_id> — because Telegram's update_id is a
# per-bot sequence, so idempotency keyed on it alone makes one bot's update look
# like a replay of another's. When enabled, every update must carry a matching
# X-Telegram-Bot-Api-Secret-Token header of at least 16 characters.
TELEGRAM_WEBHOOK_ENABLED=false
TELEGRAM_WEBHOOK_SECRET=

# Outbox relay --------------------------------------------------------------
OUTBOX_RELAY_ENABLED=true
OUTBOX_RELAY_BATCH_SIZE=100
OUTBOX_RELAY_POLL_INTERVAL_MS=1000
# Alert threshold: the relay is unhealthy if the oldest unpublished message is
# older than this (12 §10 of the architecture review: alert if lag > 5 min).
OUTBOX_RELAY_MAX_LAG_MS=300000

# How long a graceful shutdown may take before the process exits anyway.
# Keep it below the orchestrator's grace period, so a stuck close is reported
# rather than killed mid-sentence.
SHUTDOWN_TIMEOUT_MS=15000

# Provider panels: the outbound HTTP client ---------------------------------
# The whole call — DNS, connect, TLS, request and the response body. A
# per-socket timeout does not bound a panel that sends a byte every few
# seconds forever.
PANEL_HTTP_TIMEOUT_MS=10000
# Response bytes kept from a panel. Reading stops the moment this is passed.
PANEL_HTTP_MAX_RESPONSE_BYTES=524288
# Whether a panel may live on this process's own loopback interface. Refused
# outright in production: the API runs in a container, so its loopback is the
# API, and a panel URL pointing there reaches this installation's internals
# rather than a panel. The integration suite sets it true to reach a local
# fake server, which is the only legitimate use.
PANEL_HTTP_ALLOW_LOOPBACK=false
# Optional PEM bundle of extra certificate authorities to trust for panel
# calls, for a self-hosted panel behind an organisation's own CA. ADDITIONAL
# to the system trust store, never instead of it — certificate verification
# stays on either way. Leave unset for ordinary public verification.
PANEL_HTTP_CA_FILE=

# This installation's own data network — the bridge PostgreSQL and Redis sit
# on — which a panel may never point at. In production compose passes it from
# NEXA_DATA_SUBNET in deploy.env; set it here only when running outside
# compose against a network that should be refused. Private space otherwise
# stays reachable on purpose.
NEXA_DATA_SUBNET=
# EXTRA networks to refuse, comma-separated CIDRs. Empty by default.
PANEL_HTTP_DENIED_SUBNETS=

# How long one panel's connection test occupies that panel, in milliseconds.
# A probe logs into somebody else's panel: repeated without a bound it is both
# a way to sweep a network one panel edit at a time and a way to lock the
# provider account it authenticates with. Within the window the caller gets the
# stored result of the last probe of the same configuration; changing the panel
# or a credential bypasses it. There is no off switch.
#
# Raised to the wall time a whole probe can occupy when that is larger:
# PANEL_HTTP_TIMEOUT_MS x (1 + retries) x the most requests any provider's probe
# makes. A probe is NOT one request — 3X-UI's session probe is a CSRF token, a
# two-factor pre-check, a login and a status read — so at the default timeout the
# effective floor is 40s, not 10s, and a setting below that is raised.
PANEL_PROBE_COOLDOWN_MS=10000

# One TENANT's total probe allowance, and the window it refills over. Manual
# connection tests and the background monitor draw on the SAME bucket, on
# purpose: a second bucket would raise a tenant's total outbound rate, which is
# the bound's whole point. The monitor is additionally held to a reserve (see
# PANEL_MONITOR_BUDGET_RESERVE_PERCENT) so an operator can always test by hand.
#
# This is what caps how many panels one tenant can keep fresh: n panels at
# interval i need n/i probes per unit time, so 100 per 5 minutes against a
# 3-minute interval is 60 panels. See "What one installation can keep fresh" in
# docs/deployment.md.
PANEL_PROBE_TENANT_LIMIT=100
PANEL_PROBE_TENANT_WINDOW_MS=300000

# Background panel health monitoring (the `monitor` process role) ------------
#
# A dedicated process from the same image, `node dist/main.monitor.js`. Not an
# interval inside the API: a probe is an outbound call to somebody else's
# machine with a timeout measured in seconds, and it must not share the event
# loop that answers the Telegram webhook.
#
# Turning it off leaves panel health changing only when an operator presses
# "Test connection". The process still runs and still reports itself healthy —
# a deliberately disabled monitor is not a broken one.
PANEL_MONITOR_ENABLED=true

# How often the loop wakes. NOT the probe cadence: a tick that finds nothing
# due does nothing. It bounds how late a due panel can be.
PANEL_MONITOR_TICK_MS=30000

# How long a HEALTHY result stands before a re-probe. Three minutes: a panel
# that goes down should be known to be down in minutes, and the refresh lands
# well inside the fifteen-minute freshness window an operator's view is judged
# against. Capped at twelve minutes, because each panel also carries a
# deterministic spread of up to a tenth of its interval.
#
# Faster costs throughput — n panels at interval i need n/i probes per unit
# time — so PANEL_PROBE_TENANT_LIMIT and PANEL_MONITOR_BATCH_SIZE are sized for
# it. See "What one installation can keep fresh" in docs/deployment.md before
# lowering it further.
PANEL_MONITOR_HEALTHY_INTERVAL_MS=180000

# After a RETRYABLE failure — a timeout, an unreachable host, a provider error.
# These are the ones that fix themselves, so trying again soon is the point.
PANEL_MONITOR_RETRYABLE_INTERVAL_MS=120000

# After a failure that trying again CANNOT fix: rejected credentials, a refused
# target, a TLS failure, a response the provider does not produce. Long, and
# doubling to a bound with each consecutive failure, because several panels —
# 3X-UI v3.7.0 among them — lock an account after enough failed logins, and a
# monitor that resubmits a rejected password on a timer would do that to the
# operator on Nexa's behalf. An operator who fixes the credential does not wait
# this out: replacing one makes the panel due immediately.
PANEL_MONITOR_NONRETRYABLE_INTERVAL_MS=3600000

# Panels considered in one tick, and probes in flight at once. The first bounds
# the discovery query; the second bounds outbound sockets and pool checkouts.
PANEL_MONITOR_BATCH_SIZE=150
PANEL_MONITOR_CONCURRENCY=4

# The share of each tenant's probe budget the background loop must leave behind,
# as a percentage. One bucket with two floors: an operator may spend a tenant's
# capacity down to nothing, the monitor is refused below the reserve. Without
# it, a tenant whose panels are all failing and retrying would have no capacity
# left when somebody presses "Test connection".
PANEL_MONITOR_BUDGET_RESERVE_PERCENT=40

# Where the monitor writes the heartbeat its container health check reads. Its
# own file: two roles writing one would let a healthy worker mask a dead
# monitor. Written only when the database is reachable AND a monitoring
# iteration has completed recently.
PANEL_MONITOR_HEARTBEAT_PATH=/tmp/nexa-monitor.heartbeat

# Backup ---------------------------------------------------------------------
# Installation configuration, not a tenant setting: a dump is of the WHOLE
# database, and a per-tenant switch for it would be a setting that cannot mean
# what it says. The CLI also has to read this when the database is the thing
# that is broken, which is exactly when a settings table is unavailable.

# Whether the worker takes a scheduled backup at all. Off by default: an
# installation that has not configured a destination or a work directory should
# not start writing gigabytes to a path nobody chose.
BACKUP_SCHEDULE_ENABLED=false

# How long after the last SUCCESSFUL backup the next one is due, and how often
# the worker asks. Measured from the last VERIFIED artifact, so restarts do not
# multiply backups and a failing run does not reset the clock as though it had
# worked.
BACKUP_INTERVAL_MS=86400000
BACKUP_TICK_MS=300000

# Where run workspaces live. On the installation's data volume, never /tmp: a
# plaintext dump is the database with the encryption taken off, and /tmp is
# world-traversable on a default host, cleaned by a timer nobody here controls,
# and often a tmpfs a real database will not fit in.
BACKUP_WORK_DIR=/var/lib/nexa/backups

# The Telegram destination. BOTH or NEITHER — the config schema refuses one
# alone, because one alone is an installation that believes its backups are
# leaving the host when they are not. Neither set means the archive is verified
# and retained on the server, which is a backup, not a failure.
#
# A token of its own rather than the tenant's operational bot: this channel
# holds the whole database, and reusing the customer-facing bot would make the
# credential that posts backups the one most widely deployed.
#
# ADR-0011's fifth compensating control is that this chat is DEDICATED and its
# membership documented and reviewed. Nothing here can enforce that; see
# docs/backup.md.
BACKUP_TELEGRAM_CHAT_ID=
BACKUP_TELEGRAM_BOT_TOKEN=

# Ceilings on the tools and on delivery. A dump that never ends holds the
# installation's backup lock until its lease expires.
BACKUP_DUMP_TIMEOUT_MS=7200000
BACKUP_RESTORE_TIMEOUT_MS=7200000
BACKUP_DELIVERY_TIMEOUT_MS=600000

# Where pg_dump, pg_restore and psql live, when they are not on PATH. Their
# version must be compatible with the SERVER's; the manifest records both.
BACKUP_PG_BIN_DIR=

# How long a FINISHED backup run row is kept, in days.
#
# The row is the only durable evidence that a backup was taken, verified against a
# real restore, and delivered. A year, because "when did this installation last
# have a provably restorable backup" is asked after an incident rather than during
# one. Floor is 7 days; anything shorter deletes the history a diagnosis needs
# while the diagnosis is happening.
#
# This is not a size control: at a daily schedule the table gains about 365 small
# rows a year. Four classes of row are NEVER removed whatever this says — a RUNNING
# run (it is the backup lock), a run whose Telegram delivery outcome was never
# observed, the most recent successful run (the scheduler reads it), and the most
# recent run of any state (the one being diagnosed). See docs/adr/0027-retention.md.
BACKUP_RUN_RETENTION_DAYS=365

# Process heartbeats --------------------------------------------------------
# The worker, the monitor and the recovery executor serve no HTTP, so each writes
# a heartbeat file and the container healthcheck reads its age. The maximum age is
# DERIVED from the interval (three of them), so these two must agree with
# deploy/compose.yml — a unit test runs the compose healthcheck scripts against
# both the default interval and the largest the schema accepts.
WORKER_HEARTBEAT_PATH=/tmp/nexa-worker.heartbeat
WORKER_HEARTBEAT_INTERVAL_MS=10000

# Notifications -------------------------------------------------------------
# `telegram` sends. `recording` keeps messages in memory instead, which makes an
# installation look healthy while every operational alert goes nowhere — the
# schema refuses it outside development for exactly that reason.
NOTIFICATION_TRANSPORT=telegram
# Where the Telegram API lives. Overridden only by tests pointing at a fake;
# production refuses anything that is not https.
TELEGRAM_API_BASE_URL=https://api.telegram.org
NOTIFICATION_SEND_TIMEOUT_MS=10000
# The dispatcher polls PostgreSQL; there is no queue library. Switching it off
# leaves intents recorded and undelivered, which is a supported state for a
# development machine and not for an installation.
NOTIFICATION_DISPATCH_ENABLED=true
NOTIFICATION_DISPATCH_INTERVAL_MS=2000
NOTIFICATION_DISPATCH_BATCH_SIZE=10
# How long a claim is held before another replica may take it over. Two worker
# replicas is the normal case on every rolling update.
NOTIFICATION_CLAIM_LEASE_MS=120000
NOTIFICATION_BACKOFF_BASE_MS=5000
NOTIFICATION_BACKOFF_MAX_MS=300000

# Panel monitor, the rest of it ----------------------------------------------
# How long a capacity refusal holds before the scheduler reconsiders, and how
# many tenants one tick may claim. TENANTS_PER_TICK must not exceed
# PANEL_MONITOR_BATCH_SIZE; the schema refuses it.
PANEL_MONITOR_CAPACITY_INTERVAL_MS=600000
PANEL_MONITOR_TENANTS_PER_TICK=10

# Disaster recovery ---------------------------------------------------------
# Installation configuration, like backup: a restore is of the whole database, so
# a per-tenant switch could not mean what it says, and the executor has to be
# configurable in the one situation where the settings table is unavailable.
#
# A DIFFERENT directory from BACKUP_WORK_DIR, defaulting beside it, so a retention
# sweep written for one can never reach the other.
RECOVERY_WORK_DIR=/var/lib/nexa/recovery
# The ceiling on an uploaded archive, enforced on the STREAM rather than on
# content-length — a chunked request declares none. Two gigabytes, well past
# Telegram's 50 MiB document limit, because the archives that need uploading are
# precisely the ones too large to have been delivered.
RECOVERY_UPLOAD_MAX_BYTES=2147483648
RECOVERY_TICK_MS=15000
# Its OWN key, not the monitor's path with a suffix: two roles sharing a derived
# path is how a healthcheck comes to read the wrong file.
RECOVERY_HEARTBEAT_PATH=/tmp/nexa-recovery.heartbeat
# Whether an operator may upload an archive at all. On by default, and switchable
# off for an installation that would rather restore only from its own retained
# runs. Reported through the capabilities endpoint, so the Web Admin says the
# feature is off rather than offering a button the server refuses.
RECOVERY_UPLOAD_ENABLED=true
# How long a FINISHED recovery request row is kept, in days. A row that recorded a
# CUTOVER is excluded from the sweep entirely and kept for ever: it is the only
# record of what the displaced database is called.
RECOVERY_RETENTION_DAYS=365

# Build metadata (populated by CI; optional locally) -------------------------
BUILD_VERSION=
BUILD_COMMIT=
BUILD_TIME=
