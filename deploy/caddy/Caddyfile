# Production edge configuration.
#
# The routing lives in routes.caddy and is shared verbatim with the CI
# topology, so a smoke test exercises the rules that actually ship. Only the
# site address and TLS are decided here, because those are the two things CI
# cannot have: a public name and a publicly-issued certificate.

{
	email {$NEXA_ACME_EMAIL}
	# The admin API is off here for the same reason it is off in CI. Nothing in
	# this deployment reconfigures Caddy at runtime — `botctl` restarts the
	# container — so the endpoint is a local-network control plane with no
	# consumer. It binds 127.0.0.1:2019 by default and is not published, but
	# "not published" is a compose property and this is the container's own.
	admin off
	# Phase 6A PR-4: certificates on demand for the domains hosted owners point at this
	# server. Caddy asks this URL (`?domain=<name>` is appended) BEFORE it requests any
	# certificate; a 2xx is permission, anything else is refusal. The API answers 200 only for a
	# DNS-verified domain of an ACTIVE hosted bot, and only to this container: the path is not
	# routed by `routes.caddy`, so the internet cannot reach it, and a request that came through
	# the proxy carries forwarding headers the API refuses. Without the answer no certificate
	# is ever requested for an unknown name, so a stranger pointing a name here costs nothing.
	on_demand_tls {
		ask http://api:3000/internal/hosting/domain-check
	}
	# Everything else is Caddy's default and that is deliberate: automatic
	# HTTPS from Let's Encrypt, HTTP/2 and HTTP/3, OCSP stapling, and an
	# implicit :80 redirect to HTTPS for the site address below. Restating any
	# of it here would be a second place for it to be wrong.
}

import routes.caddy

# The container's own health endpoint, bound to LOOPBACK INSIDE the container:
# not published by compose, and not reachable from the other containers on the
# edge network either, because the address names 127.0.0.1 rather than a port
# on all interfaces.
#
# It exists because the obvious healthcheck is wrong. Asking
# `http://127.0.0.1:80/` on the production edge sends Host: 127.0.0.1, which
# matches no site block — the only site is the operator's domain — so the
# answer says nothing about whether the deployment's routing works. This site
# imports THE SAME snippet the public site does, so a probe against it
# exercises the real handle order, the real SPA fallback and the real asset
# root.
#
# That is not hypothetical: the one-shot that publishes the Web Admin bundle
# once failed on every start while the API stayed healthy, and only the edge
# had nothing to serve. A check that asks Caddy whether Caddy is running would
# have reported green throughout.
http://127.0.0.1:8080 {
	import nexa_routes
}

{$NEXA_DOMAIN} {
	# HSTS is set HERE rather than in the shared snippet, because it is the one
	# header that must not be sent by the CI topology: an HSTS response from a
	# plain-HTTP test origin would pin `localhost` to HTTPS in the runner's
	# client for a year. It applies to every response from this site.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	import nexa_routes
}

# A hosted bot's own domain (phase 6A PR-4). Any other name arriving on 443: the certificate
# is obtained on the first handshake, and ONLY if the `ask` endpoint above approves the name.
# The routing is the shared snippet, so the hosted Web Admin is served exactly like the owner's;
# the API tells the tenants apart by the request's Host. Not the owner's own site (the block
# above is more specific and keeps its managed certificate). HSTS without includeSubDomains:
# a hosted domain's subdomains are not ours to pin.
https:// {
	tls {
		on_demand
	}
	header Strict-Transport-Security "max-age=31536000"

	import nexa_routes
}
