# The isolated Mirza → NEXA rehearsal's application configuration. Written ONCE by
# `deploy/rehearsal/mirza-rehearsal.sh init` into the rehearsal directory (0600), with fresh
# random secrets that belong to the rehearsal alone — never a production or staging value.
# docs/legacy-migration/nxpkg-real-rehearsal.md explains every line; the unit test
# tests/unit/mirza-rehearsal-compose.test.ts parses this file through the application's own
# configuration schema and checks the isolation flags below.

# Production semantics on purpose: the importer then treats the target as production-like
# and the rehearsal walks the SAME gates a real activation will (target ack, the owner's
# cutover approval of the seven values, stop-sales, a real package only).
NODE_ENV=production
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=3000

# A NEW database on the rehearsal's own PostgreSQL container. Its name carries `rehearsal`.
DATABASE_URL=postgres://nexa:__POSTGRES_PASSWORD__@postgres:5432/nexa_mirza_rehearsal
REDIS_URL=redis://:__REDIS_PASSWORD__@redis:6379

# A keyring generated for the rehearsal. It seals the package key while an import runs and
# the rehearsal's own panel credentials (the stand-in's); it opens nothing else.
SECRETS_KEYS=__SECRETS_ACTIVE_KEY_ID__:__SECRETS_KEK__
SECRETS_ACTIVE_KEY_ID=__SECRETS_ACTIVE_KEY_ID__
SECRETS_ACCEPT_V1=false

# The browser on THIS machine, through the rehearsal's Caddy on 127.0.0.1.
WEB_ADMIN_ORIGINS=https://localhost:__HTTPS_PORT__
DEPLOYMENT_TOPOLOGY=reverse-proxy
TRUSTED_PROXY_IPS=__FRONT_SUBNET__

# --- Isolation: nothing leaves this rehearsal (the network has no route out either) -------
# No Telegram webhook, no notification delivery, no backup delivery: never connect a bot.
TELEGRAM_WEBHOOK_ENABLED=false
TELEGRAM_WEBHOOK_SECRET=
NOTIFICATION_TRANSPORT=telegram
NOTIFICATION_DISPATCH_ENABLED=false
BACKUP_TELEGRAM_CHAT_ID=
BACKUP_TELEGRAM_BOT_TOKEN=
BACKUP_SCHEDULE_ENABLED=false
# The roles that dial panels are not even started; switched off here as well.
PANEL_MONITOR_ENABLED=false
PROVISIONER_ENABLED=false
RECOVERY_UPLOAD_ENABLED=false

# --- The migration ---------------------------------------------------------------------
LEGACY_MIGRATION_ENABLED=true
LEGACY_MIGRATION_WORK_DIR=/var/lib/nexa/legacy-migration
LEGACY_MIGRATION_RETAIN_PACKAGE=false
