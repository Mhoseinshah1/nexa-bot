{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",

  // The web-surface half of the test typecheck. Split from
  // `tsconfig.tests.json` for one reason: a test that imports a `.tsx` module
  // needs `jsx` and the DOM lib, and granting those to the whole corpus would
  // let a node-only test name a browser global and still compile. Both configs
  // run under `pnpm typecheck:tests`; between them every test file is checked.
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["tests/unit/session-view.test.ts"]
}
