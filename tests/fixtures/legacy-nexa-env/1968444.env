# The application configuration a production installation runs on.
#
# THIS FILE IS A TEMPLATE. The installer copies it to /etc/nexa/nexa.env,
# substituting the __PLACEHOLDER__ tokens, and gives the result mode 0600 owned
# by root. Docker reads it as the daemon (root) through `env_file`, so no
# container needs permission to read it.
#
# It is not a hand-maintained second copy of the application's variable list.
# `tests/unit/deployment-config.test.ts` fills these placeholders and parses the
# result through the REAL `configSchema`, so a variable the application starts
# requiring fails that test rather than the first production boot — and a value
# here that the schema refuses fails it too.
#
# Only the values the deployment must DECIDE are listed. Everything the schema
# defaults sensibly is left out on purpose: restating a default is a second
# place for it to be wrong, and the defaults are already reviewed where they
# are declared.

# --- What the deployment is -------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info

# --- Where the application listens ------------------------------------------
# Inside the container only. Nothing publishes this port; Caddy reaches it on
# the internal network.
API_HOST=0.0.0.0
API_PORT=3000

# --- Generated at install time ----------------------------------------------
# The password inside DATABASE_URL is generated by the installer and appears
# only here and in postgres.env.
DATABASE_URL=postgres://nexa:__POSTGRES_PASSWORD__@postgres:5432/nexa
REDIS_URL=redis://:__REDIS_PASSWORD__@redis:6379

# The secret keyring: `id:base64,id:base64`, 32 random bytes per key.
#
# ONE key encrypts (SECRETS_ACTIVE_KEY_ID); ALL of them decrypt. That is what
# makes rotation a period of overlap instead of a flag day — the v1 envelope
# configured a single key and refused any ciphertext naming a different one, so
# rotating it made every existing row unreadable.
#
# To rotate:
#   1. append a second `id:key` pair to SECRETS_KEYS (do not remove the first);
#   2. point SECRETS_ACTIVE_KEY_ID at the new id and `botctl restart`;
#   3. `botctl secrets rewrap` until it reports nothing left to do;
#   4. `botctl secrets retire-check --key <old id>` before removing the old pair.
#
# Step 4 says whether removing the key would strand live ciphertext. It is NOT
# permission to destroy the key material: every backup taken before step 3 still
# contains ciphertext under the old key, and a fresh backup does not make those
# readable. Keep it offline until the last such backup has expired.
SECRETS_KEYS=__SECRETS_ACTIVE_KEY_ID__:__SECRETS_KEK__
SECRETS_ACTIVE_KEY_ID=__SECRETS_ACTIVE_KEY_ID__

# Whether v1 ciphertext may still be read. FALSE here, and that is not a
# tightening of an existing installation's setting — an installation created by
# this release has no v1 rows at all, so there is nothing for acceptance to be
# for.
#
# A v1 ciphertext carries no associated data and therefore remains
# transplantable between rows; v2 does not retroactively protect v1 values. An
# installation UPGRADED from a pre-keyring release still needs acceptance until
# `botctl secrets rewrap` has run, and gets it: with no explicit setting here,
# acceptance defaults on for a host still configured with the old SECRETS_KEK
# spelling and off for one using SECRETS_KEYS. `botctl secrets status` prints
# which, and `botctl secrets disable-v1` is the supported way to turn it off —
# it refuses unless the rows say the installation is ready.
SECRETS_ACCEPT_V1=false

# --- Answered by the operator -----------------------------------------------
# The admin origin, which is the second half of the CSRF defence behind the
# SameSite=Strict session cookie. The schema refuses anything that is not a
# canonical https origin in production, because the session is issued as a
# Secure __Host- cookie that a browser will not store over http.
WEB_ADMIN_ORIGINS=https://__DOMAIN__

# --- The reverse-proxy topology ---------------------------------------------
# Caddy terminates TLS and connects to the API from the `edge` network, so the
# API must believe that network's addresses about the client IP and nothing
# else. The subnet is pinned in compose.yml precisely so this can be exact:
# left empty the schema refuses to boot, and a /0 here would be `trustProxy:
# true` spelled differently — one failed-login burst would then lock out every
# administrator, because every request would appear to come from Caddy.
#
# CHANGING THE EDGE SUBNET MEANS CHANGING THIS TOO.
#
# `NEXA_EDGE_SUBNET` in /etc/nexa/deploy.env decides the network Caddy sits on,
# and this value decides which sources the API will believe an X-Forwarded-For
# from. The installer derives one from the other ONCE, at install time, and
# nothing keeps them in step afterwards.
#
# So if an operator edits NEXA_EDGE_SUBNET — to avoid a collision with another
# network on the host, say — and leaves this alone, the API stops trusting
# Caddy's forwarded headers. Every request then appears to come from the proxy
# itself, and one failed-login burst locks out every administrator at once.
# There is no error; the deployment simply starts attributing every request to
# one address.
DEPLOYMENT_TOPOLOGY=reverse-proxy
TRUSTED_PROXY_IPS=__EDGE_SUBNET__

# The installation's own data network is NOT configured here. compose hands
# it to the application from NEXA_DATA_SUBNET in deploy.env, the file that
# owns it, so it cannot go stale in a second place. Extra networks to refuse,
# if any, go in PANEL_HTTP_DENIED_SUBNETS as comma-separated CIDRs.

# --- Delivery ---------------------------------------------------------------
# `telegram` is the schema default and is restated here for one reason: the
# alternative, `recording`, keeps messages in memory instead of sending them,
# so an installation running it looks healthy while every operational alert
# goes nowhere. The schema refuses it outside development. Saying it explicitly
# means an operator reading this file can see which one is in force.
NOTIFICATION_TRANSPORT=telegram

# --- Build identity is NOT set here ------------------------------------------
#
# BUILD_VERSION, BUILD_COMMIT and BUILD_TIME are stamped into the image at
# build time, from the release workflow, and they are the only place those
# facts are true. This file must not name them.
#
# `env_file` wins over an image's own ENV, so anything written here REPLACES
# the immutable values. The installer used to write `pending` for the commit
# and the build time — it cannot know them, since it never built anything —
# and that placeholder then masked the real metadata permanently: /health/info
# reported `pending` on a correctly built release, for the life of the
# installation, and an operator had no way to tie a running container back to
# its source.
#
# The schema defaults these to `0.0.0-dev` and `unknown`, so a container run
# outside the release flow still boots and still says something true about
# itself. `unknown` is a fact; `pending` was a claim that something was about
# to be filled in, and nothing ever filled it in.
