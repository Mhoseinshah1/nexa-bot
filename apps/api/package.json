{
  "name": "@nexa/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Nexa Bot backend. One codebase, several process roles.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start:api": "node dist/main.js",
    "start:worker": "node dist/main.worker.js",
    "start:monitor": "node dist/main.monitor.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/infrastructure/persistence/migrate.js",
    "db:check": "bash ../../scripts/check-migration-drift.sh",
    "db:seed": "node dist/infrastructure/persistence/seed.js",
    "clean": "rm -rf dist",
    "admin:bootstrap": "node dist/bootstrap-owner.cli.js",
    "provision": "node dist/provision-installation.cli.js",
    "db:migrate:dev": "tsx src/infrastructure/persistence/migrate.ts",
    "db:seed:dev": "tsx src/infrastructure/persistence/seed.ts",
    "admin:bootstrap:dev": "tsx src/bootstrap-owner.cli.ts",
    "provision:dev": "tsx src/provision-installation.cli.ts"
  },
  "dependencies": {
    "@nexa/contracts": "workspace:*",
    "@nexa/i18n": "workspace:*",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-fastify": "12.0.1",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "ioredis": "5.9.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuidv7": "1.2.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.1",
    "@types/node": "22.20.1",
    "@types/pg": "8.15.6",
    "drizzle-kit": "0.31.10",
    "tsx": "4.20.6",
    "typescript": "6.0.2"
  }
}
