{
  "name": "@nexa/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Nexa Bot backend. One codebase, several process roles.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start:api": "node dist/main.js",
    "start:worker": "node dist/main.worker.js",
    "start:monitor": "node dist/main.monitor.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/infrastructure/persistence/migrate.js",
    "db:check": "bash ../../scripts/check-migration-drift.sh",
    "db:seed": "node dist/infrastructure/persistence/seed.js",
    "clean": "rm -rf dist",
    "admin:bootstrap": "node dist/bootstrap-owner.cli.js",
    "admin:2fa-reset": "node dist/admin-2fa-reset.cli.js",
    "provision": "node dist/provision-installation.cli.js",
    "backup": "node dist/backup.cli.js",
    "legacy-import": "node dist/legacy-import.cli.js",
    "rickpanel-probe": "node dist/rickpanel-probe.cli.js",
    "legacy-money-report": "node dist/legacy-money-report.cli.js",
    "cutover-reconcile": "node dist/cutover-reconcile.cli.js",
    "cutover-rehearse": "node dist/cutover-rehearse.cli.js",
    "customers-link-bot": "node dist/customers-link-bot.cli.js",
    "data-compaction": "node dist/data-compaction.cli.js",
    "db:migrate:dev": "tsx src/infrastructure/persistence/migrate.ts",
    "db:seed:dev": "tsx src/infrastructure/persistence/seed.ts",
    "admin:bootstrap:dev": "tsx src/bootstrap-owner.cli.ts",
    "admin:2fa-reset:dev": "tsx src/admin-2fa-reset.cli.ts",
    "bot:bootstrap:dev": "tsx src/bootstrap-bot.cli.ts",
    "provision:dev": "tsx src/provision-installation.cli.ts",
    "backup:dev": "tsx src/backup.cli.ts",
    "legacy-import:dev": "tsx src/legacy-import.cli.ts",
    "rickpanel-probe:dev": "tsx src/rickpanel-probe.cli.ts",
    "legacy-money-report:dev": "tsx src/legacy-money-report.cli.ts",
    "cutover-reconcile:dev": "tsx src/cutover-reconcile.cli.ts",
    "cutover-rehearse:dev": "tsx src/cutover-rehearse.cli.ts",
    "customers-link-bot:dev": "tsx src/customers-link-bot.cli.ts",
    "data-compaction:dev": "tsx src/data-compaction.cli.ts",
    "start:recovery": "node dist/main.recovery.js",
    "start:provisioner": "node dist/main.provisioner.js",
    "start:assistant": "node dist/main.assistant.js",
    "start:migration": "node dist/main.migration.js",
    "migration:dev": "tsx src/main.migration.ts",
    "support-ai-eval": "node dist/support-ai-eval.cli.js",
    "support-ai-eval:dev": "tsx src/support-ai-eval.cli.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-fastify": "12.0.2",
    "@nexa/contracts": "workspace:*",
    "@nexa/i18n": "workspace:*",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.4",
    "ioredis": "5.9.0",
    "mysql2": "3.24.4",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "qrcode-generator": "2.0.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuidv7": "1.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.1",
    "@types/node": "22.20.1",
    "@types/pg": "8.15.6",
    "drizzle-kit": "0.31.10",
    "tsx": "4.20.6",
    "typescript": "6.0.2"
  }
}
