{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",

  // Typechecks the test suite, which `pnpm typecheck` otherwise does not: the
  // package tsconfigs cover `src` only, so a test could name a type that does
  // not exist and nothing said so. A Phase 3 test asserted two
  // `ProviderFailureKind` values that were never in the enum, and it reached a
  // committed file because no check would have caught it.
  //
  // The list below is an EXCLUDE list on purpose. An include list would have to
  // be extended for every new test file, and the one nobody remembers to add is
  // the one that needed checking. This way a new file is covered the moment it
  // exists, and the debt is an explicit list that only ever shrinks.
  //
  // The list held fifteen Phase 1 and Phase 2 tests that predated this check.
  // They are all fixed and the entries are gone; what surfaced there was real —
  // among them an assertion comparing a template key against a value outside
  // its own union, which could never be true and had been passing vacuously.
  "compilerOptions": {
    // The citation checker is a `.mjs` script and the suite imports it
    // directly. `allowJs` lets TypeScript INFER its exports from the source
    // rather than from a hand-written `.d.mts` that would be free to drift
    // from it — and a declaration file that lies is exactly the shape of
    // defect the suite importing it exists to catch. `checkJs` stays off: the
    // script is linted and tested, not typechecked.
    "allowJs": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["tests/**/*.ts"],
  // Two entries, and neither is a gap. Both are DOM code, both need `jsx` and
  // the DOM lib, and the other ~55 test files must NOT have those — a node test
  // that names `document` should not compile. Both are checked by
  // `tsconfig.tests.web.json` instead, and `pnpm typecheck:tests` runs both
  // configs, so every test file is covered by exactly one of them.
  //
  // `session-view.test.ts` imports `apps/web/src/app.tsx`. `tests/web/` is the
  // browser suite in its entirety: the web config already includes all of it,
  // and this config was picking up its two `.ts` files (the rest are `.tsx`,
  // which the include glob does not match) and checking browser code without
  // the DOM. That worked only for as long as neither of them named a browser
  // global — until `setup.ts` had to polyfill `matchMedia`, which jsdom does
  // not implement and which the full-shell render needs.
  //
  // A new test that imports a `.tsx` fails here with TS6142, which is the
  // signal to add it to the web config.
  "exclude": ["tests/unit/session-view.test.ts", "tests/web/**"]
}
